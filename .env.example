# ==============================================================================
# FinSight AI - Environment Configuration Template
# Copy this file to '.env' and adjust values for local or Docker environments.
# ==============================================================================

# --- DATABASE (POSTGRESQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=finsight

# Database connection URL for SQLAlchemy (SQLite fallback: sqlite:///./finsight.db)
# Inside Docker Compose, we use the host 'postgres'
DATABASE_URL=postgresql://postgres:password123@postgres:5432/finsight

# --- CACHE & TASK QUEUE (REDIS) ---
REDIS_PORT=6379
# Inside Docker Compose, we use the host 'redis'
REDIS_URL=redis://redis:6379/0

# --- VECTOR STORE (QDRANT) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- LLM INFERENCE (OLLAMA) ---
OLLAMA_PORT=11434
# Inside Docker Compose, we use the host 'ollama'
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- SECURITY & JWT ---
# Run 'openssl rand -hex 32' in your terminal to generate a secure secret key
JWT_SECRET_KEY=e83ba56f4d2f8e12ac8bc1d6f28ef3c6759c8d35fbc08e33f381c81ef45da3c2
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
